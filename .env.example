# Supabase production mode. Without these values, the app runs an explicit local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for signed demo sessions when Supabase Auth is not configured.
ONE_SESSION_SECRET=

# Optional organization defaults
NEXT_PUBLIC_ORGANIZATION_NAME=ONE Community Services
NEXT_PUBLIC_ORGANIZATION_REGION=Your community
